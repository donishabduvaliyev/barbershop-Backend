PORT=5000
MONGO_URI=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- Admin panel additions ---
# Create this bot via @BotFather (a second, separate bot from the one above).
# Shop owners use it to log in to the admin panel and confirm/reject bookings.
SHOP_CONTROL_BOT_TOKEN=
# Long random string used to sign admin panel login sessions (JWT).
JWT_SECRET=
# Where the admin panel is hosted — used for CORS and the bot's dashboard button.
ADMIN_PANEL_URL=http://localhost:5173
# Set to "true" when running this server locally against the same database/
# bot tokens as a live deployment, so this instance doesn't fight production
# for Telegram polling or double-send reminder messages to real customers.
DISABLE_TELEGRAM_POLLING=false
# Opt-in switch for POST /api/admin/auth/dev-login, which skips Telegram
# auth entirely — only for local development. Leave unset/false anywhere
# reachable from the internet (including an ngrok tunnel), since anyone who
# finds the endpoint could otherwise log into any shop's dashboard.
ADMIN_DEV_LOGIN_ENABLED=false

# --- Photo uploads (Cloudflare R2 — an S3-compatible bucket) ---
# Dashboard -> R2 -> Manage R2 API Tokens (Account ID also shown on R2 Overview).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
# Bucket -> Settings -> Public Access -> R2.dev subdomain.
R2_PUBLIC_URL=
